{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "python", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/guard.py"], "timeout": 5}
        ]
      }
    ],
    "SessionEnd": [
      {"hooks": [{"type": "command", "command": "echo", "args": ["bye"]}]}
    ]
  }
}

{
  "name": "reeve-gui",
  "private": true,
  "version": "1.2.0",
  "description": "Reeve, a local-first coding agent",
  "author": "Reeve",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:live": "playwright test -c playwright.live.config.ts",
    "electron:build": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --target=node22 --outdir=dist-electron --out-extension:.js=.cjs --external:electron --log-level=warning",
    "electron:check": "tsc -p electron/tsconfig.json",
    "electron:dev": "npm run electron:build && electron ."
  },
  "devDependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/cascadia-code": "^5.3.0",
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/source-code-pro": "^5.3.1",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource-variable/victor-mono": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/topojson-client": "3.1.5",
    "@vitejs/plugin-react": "^4.3.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/xterm": "^5.5.0",
    "anser": "^2.3.5",
    "autoprefixer": "^10.5.2",
    "diff": "^8.0.3",
    "docx-preview": "^0.4.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-updater": "6.8.9",
    "hast-util-to-html": "^9.0.5",
    "jsdom": "^25.0.1",
    "jszip": "^3.10.2",
    "katex": "^0.18.7",
    "maplibre-gl": "6.11.2",
    "mermaid": "^11.17.2",
    "pdfjs-dist": "^4.10.38",
    "postcss": "^8.5.16",
    "pptx-preview": "^1.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "3.10.1",
    "rehype-katex": "^7.0.1",
    "remark-cjk-friendly": "^2.3.1",
    "remark-cjk-friendly-gfm-strikethrough": "^2.3.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remend": "^1.3.1",
    "shiki": "^4.4.3",
    "simple-icons": "^16.26.0",
    "tailwindcss": "^3.4.19",
    "topojson-client": "3.1.0",
    "typescript": "^5.5.3",
    "unified": "^11.0.5",
    "vite": "^5.4.0",
    "vitest": "^2.1.9",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "io.github.chrishhieu.reeve",
    "productName": "Reeve",
    "directories": {
      "output": "release",
      "buildResources": "electron/icons"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "electron/icons/**",
      "package.json",
      "!node_modules/**"
    ],
    "extraResources": [
      {
        "from": "binaries/sidecar",
        "to": "sidecar"
      },
      {
        "from": "binaries",
        "to": ".",
        "filter": [
          "reeve-stt-host",
          "reeve-stt-host.exe"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Reeve-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "electron/icons/icon.icns",
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "12.0",
      "entitlements": "electron/entitlements.plist",
      "entitlementsInherit": "electron/entitlements.plist",
      "hardenedRuntime": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Reeve records only while you use the composer microphone to turn your spoken prompt into editable text. Audio is transcribed locally and is not uploaded.",
        "NSDesktopFolderUsageDescription": "A task you run may need to read or save files on your Desktop. Reeve never scans this folder on its own.",
        "NSDocumentsFolderUsageDescription": "A task you run may need to read or save files in Documents. Reeve never scans this folder on its own.",
        "NSDownloadsFolderUsageDescription": "A task you run may need to read or save files in Downloads. Reeve never scans this folder on its own.",
        "NSPhotoLibraryUsageDescription": "A task you run may need to read an image from your photo library. Reeve never scans your photos on its own."
      }
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/chrisHHieu/reeve/releases/latest/download/"
      }
    ]
  }
}
